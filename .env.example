# Server
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/node-chat-app
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/node-chat-app
MONGO_URI=mongodb://127.0.0.1:27017/node-chat-app

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
